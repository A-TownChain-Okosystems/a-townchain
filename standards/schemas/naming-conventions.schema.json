        },
        "stddevStandardDoc": {
          "pattern": "^ATC-STD-STDDEV-[0-9]{3,}[.]md$",
          "description": "Standards-Development-Dokument"
        },
        "registryStandardDoc": {
          "pattern": "^ATC-STD-REGISTRY-[0-9]{3,}[.]md$",
          "description": "Registry-Management-Dokument"
        },
        "changeStandardDoc": {
          "pattern": "^ATC-STD-CHANGE-[0-9]{3,}[.]md$",
          "description": "Change-Control-Dokument"
        },
        "improvementStandardDoc": {
          "type": "string",
          "pattern": "^ATC-STD-IMPROVEMENT-[0-9]{3,}[.]md$",
          "example": "ATC-STD-IMPROVEMENT-001.md"
        },
        "aiGovStandardDoc": {
          "type": "string",
          "pattern": "^ATC-AI-GOV-(?:[A-Z]+-)?[0-9]{3,}[.]md$",
          "example": "ATC-AI-GOV-CHECK-001.md"
        },
        "auroraSwarmStandardDoc": {
          "type": "string",
          "pattern": "^ATC-AURORA-SWARM-[0-9]{3,}[.]md$",
          "example": "ATC-AURORA-SWARM-001.md"
        }
      }
    },
    "versionPatterns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semver"
      ],
      "properties": {
        "semver": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$",
          "example": "1.0.0",
          "note": "Version getrennt von Identitaet (7.4); Pinning via ID@version"
        }
      }
    },
    "extensionRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "prohibited"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "enum": [
              ".md",
              ".schema.json",
              ".schema.yaml",
              ".yaml",
              ".json"
            ]
          },
          "description": "Definierte Extensions fuer Governance-Dokumente"
        },
        "prohibited": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ungueltig: Unterstriche (atc_std_000.md), Leerzeichen (ATC Standard 000.md), Status-/Final-Marker (standard-final.md, standard-final-v2.md)"
        }
      }
    },
    "reservedNames": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeholders",
        "statusMarkers",
        "legacyRanges",
        "grandfathered"
      ],
      "properties": {
        "placeholders": {
          "type": "array",
          "items": {
            "enum": [
              "NNN",
              "X.Y.Z"
            ]
          },
          "description": "Platzhalter, keine IDs"
        },
        "statusMarkers": {
          "type": "array",
          "items": {
            "enum": [
              "DRAFT",
              "REVIEW",
              "CANDIDATE",
              "APPROVED",
              "STABLE",
              "FINAL"
            ]
          },
          "description": "Status ist niemals Bestandteil der ID (7.1)"
        },
        "legacyRanges": {
          "type": "array",
          "items": {
            "enum": [
              "ATC-01..99",
              "ATC-0001..0008",
              "ATS-1000..1007"
            ]
          },
          "description": "Legacy-Serien: Nummerierung bleibt gueltig, keine Neuallokation (7.9)"
        },
        "grandfathered": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^AD-[0-9]{3,}$"
          },
          "description": "DECISIONS_REGISTER-Form AD-NNN als Legacy-Form von ADR-NNN (7.9)"
        }
      }
    }
  }
}