        },
        "protocolStandardDoc": {
          "pattern": "^ATC-STD-PROTOCOL-[0-9]{3,}[.]md$",
          "description": "Protocol-Standards-Dokument"
        },
        "taxonomyStandardDoc": {
          "pattern": "^ATC-STD-TAXONOMY-[0-9]{3,}[.]md$",
