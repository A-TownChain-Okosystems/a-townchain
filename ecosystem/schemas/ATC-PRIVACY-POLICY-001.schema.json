{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-TownChain-Okosystems/a-townchain-ecosystem/blob/main/schemas/ATC-PRIVACY-POLICY-001.schema.json",
  "title": "ATC-PRIVACY-POLICY-001 machine-readable policy export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "version",
    "status",
    "requirements"
  ],
  "properties": {
    "schema_id": {
      "const": "ATC-PRIVACY-POLICY-001"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEW",
        "APPROVED",
        "DEPRECATED"
      ]
    },
    "declared_requirement_count": {
      "type": "integer",
      "minimum": 1
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approver",
        "approved_at",
        "review_ref"
      ],
      "properties": {
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "minLength": 1
        },
        "review_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "statement",
          "category",
          "normative_level",
          "mapping_status",
          "implementation_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ATC-PRIV-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "normative_level": {
            "enum": [
              "MUST",
              "SHOULD",
              "MAY"
            ]
          },
          "mapping_status": {
            "enum": [
              "MAPPED",
              "MISSING",
              "DUPLICATE",
              "UNRESOLVED",
              "EXCLUDED"
            ]
          },
          "implementation_status": {
            "enum": [
              "NOT_ASSESSED",
              "PLANNED",
              "IMPLEMENTED",
              "VERIFIED",
              "RESIDUAL",
              "BLOCKED",
              "EXCLUDED"
            ]
          },
          "catalog_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclusion_reason": {
            "type": "string",
            "minLength": 1
          },
          "duplicate_of": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "commit_sha",
                "path",
                "symbol",
                "blob_sha",
                "test_id",
                "workflow_run_id",
                "job",
                "step",
                "exit_code",
                "review_ref"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^[^/]+/[^/]+$"
                },
                "commit_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "blob_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40,64}$"
                },
                "test_id": {
                  "type": "string",
                  "minLength": 1
                },
                "workflow_run_id": {
                  "type": "string",
                  "minLength": 1
                },
                "job": {
                  "type": "string",
                  "minLength": 1
                },
                "step": {
                  "type": "string",
                  "minLength": 1
                },
                "exit_code": {
                  "const": 0
                },
                "review_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "artifact_sha256": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
