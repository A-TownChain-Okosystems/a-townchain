  "security_invariants": [
    "UI toggle is a request, not authority.",
    "UI -> API -> Identity -> Capability -> Policy -> Validation -> Authoritative State -> Audit",
    "Unknown authorization or approval context fails closed.",
    "Model output does not grant privilege; Aurora actions follow capability and policy checks, with approval when required.",
    "Wallet signing, transaction submission, consensus, VM execution, kernel/TCB changes, TPM/TEE operations and security-policy changes cannot bypass authoritative boundaries.",
    "Configuration intent, observed state and verified evidence remain distinct."
  ],
  "reconciliation_gates": [
    "Enumerate actual routes, screens, commands, settings keys, schemas, APIs, IPC/RPC surfaces and service symbols from canonical source HEADs.",
    "Map every runtime/UI symbol to a catalog ID or a reproducible exclusion reason.",
    "Map every catalog item to source or mark BLOCKED/RESIDUAL with reason.",
    "Detect duplicate/overlapping functions and preserve one canonical owner.",
    "Run schema validation and strict bidirectional reconciliation with completeness required.",
    "Record exact HEAD SHA and Run -> Job -> Step -> exit code/log or artifact evidence.",
    "Keep Draft and release BLOCKED until mandatory gates pass; no gate weakening or authorization bypass."
  ],
  "known_residuals": [
    "GlobusOS PR #27 has an existing OS/UI/settings baseline and remains the detailed source catalog.",
    "Cross-repository source heads, routes, APIs and setting contracts are not reconciled by this draft.",
    "Catalog presence does not prove implementation, test, CI verification, E2E or production readiness.",
    "Concrete setting keys, schemas, owner symbols, tests and exact-SHA evidence remain to be collected."
  ],
