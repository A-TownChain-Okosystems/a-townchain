    "observed_repository_count": 33,
    "active_repository_count": 26,
    "archived_repository_count": 7,
    "evidence": "Live GitHub API observation on 2026-10-11: default branch, archive flag, exact observed HEAD SHA, and observed Git tree SHA captured for all 33 repositories. These are inventory observations only; last_verified_head_sha and CI evidence remain unset until repository-specific gates pass."
  },
  "integration_gates": [
    {
      "id": "INT-001",
      "name": "Inventory and provenance",
      "requirement": "Record repository URL, default branch, full HEAD SHA, tree SHA, archive flag, and snapshot timestamp for every repository.",
      "status": "RESIDUAL",
      "required_terminal_status": "VERIFIED",
      "result": "Repository refs/tree SHAs captured for all 33 repos; repository-specific CI evidence and ownership/integration verification remain separate and open."
    },
    {
      "id": "INT-002",
      "name": "Canonical ownership",
      "requirement": "Exactly one canonical implementation owner per capability; mirrors and spec-only repositories explicitly labeled.",
      "status": "NOT_RUN",
      "required_terminal_status": "VERIFIED"
    },
    {
      "id": "INT-003",
      "name": "Dependency and interface graph",
      "requirement": "Every active repository declares upstream/downstream dependencies and versioned interface/contract references; unresolved edges remain RESIDUAL.",
      "status": "NOT_RUN",
      "required_terminal_status": "VERIFIED"
    },
    {
      "id": "INT-004",
      "name": "Standards conformance",
      "requirement": "Validate each active repository against atc-standards using exact checked-out SHA; manual/hybrid checks remain not evaluated until evidence exists.",
      "status": "NOT_RUN",
      "required_terminal_status": "VERIFIED"
    },
    {
      "id": "INT-005",
      "name": "Build and test evidence",
      "requirement": "Record per-repository required workflow run, job, step, exit code, logs/artifacts and exact SHA; historical or branch-only CI is insufficient.",
      "status": "NOT_RUN",
      "required_terminal_status": "VERIFIED"
    },
    {
      "id": "INT-006",
      "name": "Cross-repository integration",
      "requirement": "Run contract/API compatibility tests for declared edges without copying canonical implementations into the ecosystem repository.",
      "status": "NOT_RUN",
      "required_terminal_status": "VERIFIED"
    },
    {
      "id": "INT-007",
      "name": "Archive and migration decision",
      "requirement": "For migrated-but-active repos, verify source-to-subtree history/SHA and make an explicit KEEP, SYNC, ARCHIVE, or REACTIVATE decision.",
      "status": "RESIDUAL",
      "required_terminal_status": "VERIFIED",
      "result": "All four canonical component directories exist, but source-root tree SHAs differ from target subtree SHAs; migration completeness/history and KEEP/SYNC/ARCHIVE decisions remain unresolved."
    },
    {
      "id": "INT-008",
      "name": "Release readiness",
      "requirement": "No repository is release-ready unless required exact-SHA gates pass and no unapproved critical residual remains.",
      "status": "NOT_RUN",
      "required_terminal_status": "VERIFIED"
    }
  ],
