    ],
    "rules": [
      "Preserve all existing component_id, function_id and interface_id values.",
      "Do not infer a source mapping from a display name or repository name alone.",
      "Do not conflate category/family/class with architecture layer, sublayer, canonical ownership, implementation status or verification status.",
      "Allow multiple taxonomy labels only through explicit references; every record must retain one canonical implementation owner.",
      "Classify tests, documentation and generated artifacts explicitly; do not count them as runtime functions.",
      "Keep unresolved mappings UNRESOLVED and implementation/verification states conservative until exact-SHA evidence is reviewed.",
      "The ecosystem repository remains the catalog, integration, compliance and evidence control plane; it is not an alternate implementation SSOT.",
      "ATC-VM remains a-townchain/components/vm; ShivaCore kernel remains globus-os/modules/atc-shivacore/kernel; wallet signing/key operations use canonical atc-wallet interfaces.",
      "ATCB versus ATC1 and unresolved consensus/finality decisions remain BLOCKED until normative evidence resolves them.",
      "Validators must fail closed on duplicate IDs, dangling category/family/class references, invalid parent relationships and missing required source evidence for MAPPED records."
    ]
  },
  "catalog_integration": {
    "canonical_catalog": "docs/architecture/ATC-COMPONENT-FUNCTION-CATALOG-001.json",
    "integration_status": "TAXONOMY_REGISTER_ADDED_CATALOG_BINDINGS_NOT_YET_RECONCILED",
    "next_steps": [
      "Add validated category_id/family_id/class_id references to existing catalog component/function/interface records without replacing their IDs.",
      "Implement taxonomy validation and regression tests.",
      "Reconcile all active repositories against the exact-HEAD symbol census and classify missing contracts.",
      "Record exact workflow run/job/step/exit code/log or artifact evidence before marking any mapping VERIFIED."
    ]
  }
