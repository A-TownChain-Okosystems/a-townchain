// ATCLang v0.3 — atc-sdk protocol type helpers
// ATC-Standard: ATC-24

module types {
    fn is_valid_height(height: u64) -> bool {
        return height >= 0;
    }

    fn is_valid_amount(amount: u64) -> bool {
        return amount >= 0;
    }
}
