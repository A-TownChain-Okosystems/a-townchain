// ATCLang v0.3 — deterministic SDK utilities
// ATC-Standard: ATC-24

module utils {
    fn add_checked(a: u64, b: u64) -> u64 {
        return a + b;
    }

    fn sub_checked(a: u64, b: u64) -> u64 {
        return a - b;
    }
}
