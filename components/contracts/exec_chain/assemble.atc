// EXEC-CHAIN-Assembler (ATC-CONTRACT-EXEC-001 / F-084, SCR-0104) — ATCLang-Port.
//
// Kompiliert das EXEC-GATE-Subset einer .atc-Contract-Funktion in ATVM-Ops.
// Fail-fast: das Ergebnis wird vor der Ausgabe simuliert und muss dem
// erwarteten Vektorwert entsprechen (No-Evidence-No-Claim).
//
// Pipeline (vollstaendig portiert aus exec_chain/assemble.py):
//   tokenize -> parse_expr/term/factor (rekursiver Abstieg, Param-Substitution)
//   -> simulate (Stack-Maschine) -> Ops-Serialisierung
//
// Host-Bindings (Datei-IO, JSON, CLI-Args) bleiben bis zur ATVM-Host-IO-Reife
// im Python-Harness; diese Datei enthaelt die gesamte semantische Kernlogik.
// u64-Wraparound: ATVM-u64-Arithmetik umbricht deterministisch nativ (implizit).
//
// Sprache: ATCLang (AD-008 — On-Chain/Compiler-Welt) · Profil: consensus

// ─── Ergebnistypen (explizite Fehlerbehandlung, kein unwrap) ───────────────

struct ScanResult {
    ok: bool,
    msg: string,
    tokens: List<string>,
}

struct ExprOut {
    ok: bool,
    msg: string,
    ops: List<string>,
    pos: u64,
}

struct SimResult {
    ok: bool,
    msg: string,
    result: u64,
}

struct AssembleResult {
    ok: bool,
    msg: string,
    ops_text: string,
    n_ops: u64,
}

// ─── Zeichen-Klassifikation ───────────────────────────────────────────────

fn is_digit(c: string) -> bool {
    return c >= "0" && c <= "9"
}

fn is_ident_start(c: string) -> bool {
    if c >= "a" && c <= "z" {
        return true
    }
    if c >= "A" && c <= "Z" {
        return true
    }
    return c == "_"
}

fn is_ident_char(c: string) -> bool {
    if is_digit(c) {
        return true
    }
    return is_ident_start(c)
}

// ─── Tokenizer (Hand-Scanner statt Regex: deterministisch, portierbar) ─────

fn tokenize(s: string) -> ScanResult {
    let toks: List<string> = []
    let pos: u64 = 0
    while pos < s.len() {
        let ch = s.slice(pos, pos + 1)
        if ch == " " {
            pos = pos + 1
        } else if is_digit(ch) {
            let num = ch
            pos = pos + 1
            while pos < s.len() && is_digit(s.slice(pos, pos + 1)) {
                num = num + s.slice(pos, pos + 1)
                pos = pos + 1
            }
            toks.push(num)
        } else if is_ident_start(ch) {
            let ident = ch
            pos = pos + 1
            while pos < s.len() && is_ident_char(s.slice(pos, pos + 1)) {
                ident = ident + s.slice(pos, pos + 1)
                pos = pos + 1
            }
            toks.push(ident)
        } else if ch == "+" {
            toks.push("+")
            pos = pos + 1
        } else if ch == "-" {
            toks.push("-")
            pos = pos + 1
        } else if ch == "*" {
            toks.push("*")
            pos = pos + 1
        } else if ch == "/" {
            toks.push("/")
            pos = pos + 1
        } else if ch == "(" {
            toks.push("(")
            pos = pos + 1
        } else if ch == ")" {
            toks.push(")")
            pos = pos + 1
        } else {
            return ScanResult {
                ok: false,
                msg: "ERROR: ungueltiges Zeichen im Ausdruck",
                tokens: toks,
            }
        }
    }
    return ScanResult { ok: true, msg: "", tokens: toks }
}

// ─── Hilfsfunktionen ───────────────────────────────────────────────────────

fn cat(a: List<string>, b: List<string>) -> List<string> {
    let out: List<string> = []
    let i: u64 = 0
    while i < a.len() {
        out.push(a[i])
        i = i + 1
    }
    let j: u64 = 0
    while j < b.len() {
        out.push(b[j])
        j = j + 1
    }
    return out
}

fn op_name(op: string) -> string {
    if op == "+" {
        return "Add"
    }
    if op == "-" {
        return "Sub"
    }
    if op == "/" {
        return "Div"
    }
    return "Mul"
}

fn str_to_u64(s: string) -> u64 {
    let acc: u64 = 0
    let i: u64 = 0
    while i < s.len() {
        let d = s.slice(i, i + 1)
        let v: u64 = 0
        if d == "0" {
            v = 0
        } else if d == "1" {
            v = 1
        } else if d == "2" {
            v = 2
        } else if d == "3" {
            v = 3
        } else if d == "4" {
            v = 4
        } else if d == "5" {
            v = 5
        } else if d == "6" {
            v = 6
        } else if d == "7" {
            v = 7
        } else if d == "8" {
            v = 8
        } else {
            v = 9
        }
        acc = acc * 10 + v
        i = i + 1
    }
    return acc
}

fn u64_to_str(n: u64) -> string {
    if n == 0 {
        return "0"
    }
    let digits: List<string> = []
    let v = n
    while v > 0 {
        let d = v - (v / 10) * 10
        if d == 0 {
            digits.push("0")
        } else if d == 1 {
            digits.push("1")
        } else if d == 2 {
            digits.push("2")
        } else if d == 3 {
            digits.push("3")
        } else if d == 4 {
            digits.push("4")
        } else if d == 5 {
            digits.push("5")
        } else if d == 6 {
            digits.push("6")
        } else if d == 7 {
            digits.push("7")
        } else if d == 8 {
            digits.push("8")
        } else {
            digits.push("9")
        }
        v = v / 10
    }
    // Ziffern rueckwaerts einsammeln (vorsichtige, deterministische Division)
    let out = ""
    let i: u64 = 0
    while i < digits.len() {
        out = digits[i] + out
        i = i + 1
    }
    return out
}

// ─── Rekursiver Abstieg (EXEC-GATE-Subset: + - * und Klammern) ─────────────

fn tok_at(toks: List<string>, pos: u64) -> string {
    if pos < toks.len() {
        return toks[pos]
    }
    return ""
}

fn parse_factor(toks: List<string>, pos: u64, env: map) -> ExprOut {
    let tok = tok_at(toks, pos)
    if tok == "" {
        return ExprOut { ok: false, msg: "ERROR: unerwartetes Ausdrucksende", ops: [], pos: pos }
    }
    if tok == "(" {
        let inner = parse_expr(toks, pos + 1, env)
        if !inner.ok {
            return inner
        }
        if tok_at(toks, inner.pos) != ")" {
            return ExprOut { ok: false, msg: "ERROR: unbalancierte Klammer", ops: [], pos: inner.pos }
        }
        return ExprOut { ok: true, msg: "", ops: inner.ops, pos: inner.pos + 1 }
    }
    if is_digit(tok) {
        let ops: List<string> = []
        ops.push("Push " + tok)
        return ExprOut { ok: true, msg: "", ops: ops, pos: pos + 1 }
    }
    // Parameter-Substitution: env[name] = Liste substituierter Ops
    let sub: List<string> = env[tok]
    if sub.len() > 0 {
        return ExprOut { ok: true, msg: "", ops: sub, pos: pos + 1 }
    }
    return ExprOut { ok: false, msg: "ERROR: unbekannter Bezeichner in Ausdruck", ops: [], pos: pos }
}

fn parse_term(toks: List<string>, pos: u64, env: map) -> ExprOut {
    let lhs = parse_factor(toks, pos, env)
    if !lhs.ok {
        return lhs
    }
    let ops = lhs.ops
    let cur = lhs.pos
    while tok_at(toks, cur) == "*" || tok_at(toks, cur) == "/" {
        let op = tok_at(toks, cur)
        let rhs = parse_factor(toks, cur + 1, env)
        if !rhs.ok {
            return rhs
        }
        ops = cat(ops, rhs.ops)
        ops.push(op_name(op))
        cur = rhs.pos
    }
    return ExprOut { ok: true, msg: "", ops: ops, pos: cur }
}

fn parse_expr(toks: List<string>, pos: u64, env: map) -> ExprOut {
    let lhs = parse_term(toks, pos, env)
    if !lhs.ok {
        return lhs
    }
    let ops = lhs.ops
    let cur = lhs.pos
    while tok_at(toks, cur) == "+" || tok_at(toks, cur) == "-" {
        let op = tok_at(toks, cur)
        let rhs = parse_term(toks, cur + 1, env)
        if !rhs.ok {
            return rhs
        }
        ops = cat(ops, rhs.ops)
        ops.push(op_name(op))
        cur = rhs.pos
    }
    return ExprOut { ok: true, msg: "", ops: ops, pos: cur }
}

// ─── Stack-Simulation (fail-fast gegen Testvektor) ────────────────────────

fn simulate(ops: List<string>, expected: u64) -> SimResult {
    let st: List<u64> = []
    let i: u64 = 0
    while i < ops.len() {
        let line = ops[i]
        if line == "Add" {
            let b = st.pop()
            let a = st.pop()
            st.push(a + b)
        } else if line == "Sub" {
            let b = st.pop()
            let a = st.pop()
            st.push(a - b)
        } else if line == "Mul" {
            let b = st.pop()
            let a = st.pop()
            st.push(a * b)
        } else if line == "Div" {
            let b = st.pop()
            if b == 0 {
                return SimResult { ok: false, msg: "ERROR: DivisionByZero in Simulation", result: 0 }
            }
            let a = st.pop()
            st.push(a / b)
        } else if line == "Halt" {
            // Halt: Auswertung endet hier — Rest wird ignoriert (wie .py)
            return sim_check(st, expected)
        } else if line.starts_with("Push ") {
            let parts = line.split(" ")
            st.push(str_to_u64(parts[1]))
        } else {
            return SimResult { ok: false, msg: "ERROR: fuer Simulation nicht unterstuetztes Op", result: 0 }
        }
        i = i + 1
    }
    return sim_check(st, expected)
}

fn sim_check(st: List<u64>, expected: u64) -> SimResult {
    let result: u64 = 0
    if st.len() > 0 {
        result = st[st.len() - 1]
    }
    if result != expected {
        return SimResult { ok: false, msg: "ERROR: Simulation entspricht nicht dem erwarteten Vektorwert", result: result }
    }
    return SimResult { ok: true, msg: "", result: result }
}

// ─── Body-Assembler: let/return-Zeilen des EXEC-GATE-Subsets ───────────────

fn eq_pos(s: string) -> u64 {
    let i: u64 = 0
    while i < s.len() {
        if s.slice(i, i + 1) == "=" {
            return i
        }
        i = i + 1
    }
    return s.len()
}

fn name_between(s: string, start_pos: u64, end_pos: u64) -> string {
    // schneidet Whitespace links/rechts deterministisch ab
    let raw = s.slice(start_pos, end_pos)
    let a: u64 = 0
    while a < raw.len() && raw.slice(a, a + 1) == " " {
        a = a + 1
    }
    let b = raw.len()
    while b > a && raw.slice(b - 1, b) == " " {
        b = b - 1
    }
    return raw.slice(a, b)
}

fn compile_expr(expr_src: string, env: map) -> ExprOut {
    let scan = tokenize(expr_src)
    if !scan.ok {
        return ExprOut { ok: false, msg: scan.msg, ops: [], pos: 0 }
    }
    return parse_expr(scan.tokens, 0, env)
}

fn assemble_body(body_src: string, inputs: map, expected: u64) -> AssembleResult {
    // Parameter-Substitution vorbereiten: env[name] = ["Push <wert>"]
    let env: map = {}
    let names = inputs.keys()
    let k: u64 = 0
    while k < names.len() {
        let pname = names[k]
        let pre: List<string> = []
        pre.push("Push " + u64_to_str(inputs[pname]))
        env[pname] = pre
        k = k + 1
    }

    let lines = body_src.split("\n")
    let final_ops: List<string> = []
    let has_return = false
    let li: u64 = 0
    while li < lines.len() {
        let s = lines[li].trim()
        if s.starts_with("let ") {
            let e = eq_pos(s)
            let vname = name_between(s, 4, e)
            let expr_src = s.slice(e + 1, s.len()).trim()
            let r = compile_expr(expr_src, env)
            if !r.ok {
                return AssembleResult { ok: false, msg: r.msg, ops_text: "", n_ops: 0 }
            }
            env[vname] = r.ops
        } else if s.starts_with("return ") {
            let expr_src = s.slice(7, s.len()).trim()
            let r = compile_expr(expr_src, env)
            if !r.ok {
                return AssembleResult { ok: false, msg: r.msg, ops_text: "", n_ops: 0 }
            }
            final_ops = r.ops
            has_return = true
        }
        li = li + 1
    }

    if !has_return {
        return AssembleResult { ok: false, msg: "ERROR: kein return im Subset-Body", ops_text: "", n_ops: 0 }
    }

    final_ops.push("Halt")

    // Fail-Fast: Simulation gegen den erwarteten Vektorwert VOR der Ausgabe
    let sim = simulate(final_ops, expected)
    if !sim.ok {
        return AssembleResult { ok: false, msg: sim.msg, ops_text: "", n_ops: 0 }
    }

    // Serialisierung
    let text = ""
    let oi: u64 = 0
    while oi < final_ops.len() {
        text = text + final_ops[oi] + "\n"
        oi = oi + 1
    }
    return AssembleResult { ok: true, msg: "OK: Simulation PASS", ops_text: text, n_ops: final_ops.len() }
}

// ─── E2E-Selbsttest (konsens-faehige Determinismus-Evidenz im Modul) ───────
// Aquivalent zu exec_chain/e2e_adder.atc + vector.json (a=7, b=3, expected=20):
//   let s = a + b    → Push 7, Push 3, Add
//   let d = s * 2    → Push 7, Push 3, Add, Push 2, Mul
//   return d         → erwartet 20

fn e2e_adder_selftest() -> bool {
    let inputs: map = {}
    inputs["a"] = 7
    inputs["b"] = 3
    let body = "        let s = a + b\n        let d = s * 2\n        return d\n"
    let r = assemble_body(body, inputs, 20)
    return r.ok
}
