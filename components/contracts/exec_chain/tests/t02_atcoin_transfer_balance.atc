// EXEC-GATE-Test — portiert aus tests/test_atcoin.py::test_transfer_moves_funds
// (ATC-95-Testmigration, atc-contracts#5): Transfer-Buchhaltung:
// Alice 1000 - 100 = 900 (Bob erhaelt 100, hier Alice-Sicht).
contract T02AtCoinTransferBalance {
    fn compute(balance: u64, spent: u64) -> u64 {
        let remaining = balance - spent
        return remaining
    }
}
