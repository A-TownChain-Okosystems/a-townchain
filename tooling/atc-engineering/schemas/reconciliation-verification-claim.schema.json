{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-TownChain-Okosystems/atc-engineering/blob/main/schemas/reconciliation-verification-claim.schema.json",
  "title": "Scoped reconciliation verification claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "claim_id", "scope", "checked_commit_sha", "decision", "criteria", "evidence"],
  "properties": {
    "status": {"const": "VERIFIED"},
    "claim_id": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "minProperties": 1,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["repository", "organization"]},
        "repository": {"type": "string", "minLength": 1},
        "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "repositories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_repositories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "organization"}}, "required": ["kind"]},
          "then": {"required": ["repositories", "evidence_repositories"]}
        },
        {
          "if": {"properties": {"kind": {"const": "repository"}}, "required": ["kind"]},
          "then": {"required": ["repository"]}
        }
      ]
    },
    "checked_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "decision": {"const": "PASS"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "result", "evidence_ids"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "result": {"const": "PASS"},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "head_sha", "workflow_run_id", "job", "step"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "workflow_run_id": {"type": "integer", "minimum": 1},
          "job": {"type": "string", "minLength": 1},
          "step": {"type": "string", "minLength": 1},
          "artifact_id": {"type": ["string", "integer"], "minLength": 1},
          "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "log_reference": {"type": "string", "pattern": "^https://.+"}
        },
        "oneOf": [
          {"required": ["artifact_id", "artifact_sha256"]},
          {"required": ["log_reference"]}
        ]
      }
    }
  }
}
