{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-TownChain-Okosystems/atc-engineering/blob/main/schemas/org-function-catalog.schema.json",
  "title": "A-TownChain Organization Function Catalog",
  "description": "Source-bound discovery catalog. Schema validity does not imply completeness or verification.",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "observed_commit_sha",
    "generated_at",
    "status",
    "files",
    "symbols",
    "exclusions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "observed_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "DETECTED",
        "DOCUMENTED",
        "IMPLEMENTED",
        "VERIFIED",
        "STALE",
        "BLOCKED",
        "RESIDUAL",
        "FAILED"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "language",
          "classification",
          "blob_sha",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "first_party",
              "test",
              "generated",
              "vendored",
              "archived",
              "documentation",
              "configuration",
              "repository_metadata",
              "dependency_lockfile",
              "legal_text",
              "ownership_metadata",
              "unknown"
            ]
          },
          "blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "status": {
            "enum": [
              "ANALYSED",
              "SKIPPED",
              "PARSE_ERROR",
              "UNSUPPORTED"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "parser_coverage": {
      "type": "object",
      "description": "Per-language extraction coverage. These metrics are DETECTED evidence and do not establish completeness or verification.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parser_mode",
          "files_seen",
          "files_excluded_by_policy",
          "files_analysed",
          "unsupported_files",
          "parse_errors",
          "symbols_detected",
          "status"
        ],
        "properties": {
          "parser_mode": {
            "enum": ["python_ast", "tree_sitter_rust_cst", "tree_sitter_bash_cst", "stdlib_json", "commonmark_ast", "stdlib_tomllib", "pyyaml_ast", "explicit_unknown_classifier", "heuristic_regex", "none"]
          },
          "files_seen": { "type": "integer", "minimum": 0 },
          "files_excluded_by_policy": { "type": "integer", "minimum": 0 },
          "files_analysed": { "type": "integer", "minimum": 0 },
          "unsupported_files": { "type": "integer", "minimum": 0 },
          "parse_errors": { "type": "integer", "minimum": 0 },
          "symbols_detected": { "type": "integer", "minimum": 0 },
          "status": {
            "enum": [
              "AUTHORITATIVE_COMPLETE",
              "EXCLUDED_BY_POLICY",
              "UNSUPPORTED",
              "PARTIAL",
              "HEURISTIC_PARTIAL",
              "DETECTED_NOT_VERIFIED"
            ]
          }
        }
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "symbol_id",
          "repository",
          "path",
          "language",
          "symbol_kind",
          "qualified_name",
          "visibility",
          "source_start_line",
          "source_end_line",
          "source_blob_sha",
          "observed_commit_sha",
          "status",
          "component_id",
          "contract_refs",
          "limitations"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          },
          "symbol_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string"
          },
          "symbol_kind": {
            "type": "string",
            "minLength": 1
          },
          "qualified_name": {
            "type": "string",
            "minLength": 1
          },
          "signature": {
            "type": "string"
          },
          "visibility": {
            "enum": [
              "public",
              "private",
              "protected",
              "exported",
              "unknown"
            ]
          },
          "summary": {
            "type": "string"
          },
          "parameters": {
            "type": "array"
          },
          "return_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "errors": {
            "type": "array"
          },
          "side_effects": {
            "type": "array"
          },
          "security_boundary": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "callers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "callees": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "doc_url_or_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_start_line": {
            "type": "integer",
            "minimum": 1
          },
          "source_end_line": {
            "type": "integer",
            "minimum": 1
          },
          "source_blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "observed_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "status": {
            "enum": [
              "DETECTED",
              "DOCUMENTED",
              "IMPLEMENTED",
              "VERIFIED",
              "STALE",
              "BLOCKED",
              "RESIDUAL",
              "FAILED"
            ]
          },
          "canonical_owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "component_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "contract_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "exclusion_id",
          "repository",
          "path",
          "reason_code",
          "category",
          "reason",
          "rationale",
          "source_blob_sha",
          "evidence"
        ],
        "properties": {
          "exclusion_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason_code": {
            "enum": [
              "READ_ERROR",
              "ARCHIVED",
              "VENDORED",
              "GENERATED",
              "UNSUPPORTED_FORMAT",
              "UNCLASSIFIED_UNKNOWN_FORMAT",
              "NON_UTF8",
              "PARSE_ERROR",
              "REPOSITORY_METADATA",
              "DEPENDENCY_LOCKFILE",
              "LEGAL_TEXT",
              "OWNERSHIP_METADATA",
              "SYMLINK_FILE_NOT_FOLLOWED",
              "EXCLUDED_DIRECTORY",
              "SYMLINK_NOT_FOLLOWED"
            ]
          },
          "category": {
            "enum": [
              "read_failure",
              "archived",
              "vendored",
              "generated",
              "unsupported_format",
              "encoding_failure",
              "parse_failure",
              "scanner_policy",
              "safety_boundary",
              "repository_metadata",
              "dependency_lockfile",
              "legal_text",
              "ownership_metadata"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "source_blob_sha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "reference"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
