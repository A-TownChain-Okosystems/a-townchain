{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-TownChain-Okosystems/genesis-engine/blob/main/docs/architecture/unreal-engine-capability-parity.schema.json",
  "title": "Genesis Engine Capability Parity Catalog",
  "type": "object",
  "required": [
    "catalog_id",
    "schema_version",
    "repository",
    "intent",
    "legal_and_architecture_boundary",
    "completeness_definition",
    "status_vocabulary",
    "feature_count",
    "domains",
    "capabilities"
  ],
  "properties": {
    "catalog_id": {
      "const": "GENESIS-ENGINE-UNREAL-CAPABILITY-PARITY"
    },
    "schema_version": {
      "type": "string"
    },
    "created_on": {
      "type": "string",
      "format": "date"
    },
    "repository": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "legal_and_architecture_boundary": {
      "type": "object",
      "required": [
        "clean_room_implementation",
        "copy_unreal_source_or_proprietary_assets",
        "reproduce_trademarks_or_branding",
        "engine_standalone",
        "chronicles_specific_logic_in_engine_core",
        "note"
      ],
      "properties": {
        "clean_room_implementation": {
          "const": true
        },
        "copy_unreal_source_or_proprietary_assets": {
          "const": false
        },
        "reproduce_trademarks_or_branding": {
          "const": false
        },
        "engine_standalone": {
          "const": true
        },
        "chronicles_specific_logic_in_engine_core": {
          "const": false
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "completeness_definition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status_vocabulary": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "NOT_ASSESSED",
          "SPECIFIED",
          "MAPPED",
          "IMPLEMENTED",
          "VERIFIED",
          "BLOCKED",
          "EXCLUDED",
          "EXTERNAL_DEPENDENCY"
        ]
      }
    },
    "feature_count": {
      "type": "integer",
      "minimum": 1
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "capability_count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "capability_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "capability",
          "domain",
          "title",
          "parity_level",
          "priority",
          "status",
          "target_contract",
          "source_binding",
          "acceptance_evidence",
          "dependencies",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UEP-[A-Z0-9-]+-[0-9]{3}$"
          },
          "capability": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "parity_level": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "status": {
            "enum": [
              "NOT_ASSESSED",
              "SPECIFIED",
              "MAPPED",
              "IMPLEMENTED",
              "VERIFIED",
              "BLOCKED",
              "EXCLUDED",
              "EXTERNAL_DEPENDENCY"
            ]
          },
          "target_contract": {
            "type": "string"
          },
          "source_binding": {
            "type": [
              "object",
              "null"
            ]
          },
          "acceptance_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
