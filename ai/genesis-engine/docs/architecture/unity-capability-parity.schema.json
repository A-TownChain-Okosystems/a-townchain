{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-townchain-okosystems.github.io/genesis-engine/unity-capability-parity.schema.json",
  "title": "Genesis Engine Unity Capability Parity Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "purpose",
    "baseline",
    "lifecycle_statuses",
    "domain_count",
    "capability_count",
    "domain_counts",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "NOT_ASSESSED",
          "SPECIFIED",
          "MAPPED",
          "IMPLEMENTED",
          "VERIFIED",
          "BLOCKED",
          "EXCLUDED",
          "EXTERNAL_DEPENDENCY"
        ]
      }
    },
    "domain_count": {
      "type": "integer",
      "minimum": 1
    },
    "capability_count": {
      "type": "integer",
      "minimum": 1
    },
    "domain_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "domain_label",
          "target_contract",
          "priority",
          "status",
          "source_binding",
          "acceptance_evidence",
          "dependencies",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UNITY-[A-Z0-9_]+-[0-9]{3}$"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "domain_label": {
            "type": "string",
            "minLength": 1
          },
          "target_contract": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "status": {
            "enum": [
              "NOT_ASSESSED",
              "SPECIFIED",
              "MAPPED",
              "IMPLEMENTED",
              "VERIFIED",
              "BLOCKED",
              "EXCLUDED",
              "EXTERNAL_DEPENDENCY"
            ]
          },
          "source_binding": {
            "type": [
              "object",
              "null"
            ]
          },
          "acceptance_evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
