// ATCLang v0.3 — atc-sdk client primitives
// ATC-Standard: ATC-24

module client {
    fn request_id(seed: u64) -> u64 {
        return seed + 1;
    }

    fn next_nonce(nonce: u64) -> u64 {
        return nonce + 1;
    }
}
