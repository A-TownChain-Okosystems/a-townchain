# A-TownChain OS — Frontend Dockerfile (K5 Konsolidierung)
# Service: Static Frontend served by Nginx
# Agent: Aurora #2 (6a275618)

FROM nginx:1.25-alpine

LABEL maintainer="ShivaCore <dev@atownchain.io>"
LABEL org.opencontainers.image.source="https://github.com/A-TownChain-Okosystems/a-townchain-os"
LABEL org.opencontainers.image.description="A-TownChain OS — Frontend (Nginx)"
LABEL org.opencontainers.image.version="1.0.0"

# Copy frontend static files
COPY frontend/ /usr/share/nginx/html

# Custom Nginx config for SPA routing
RUN cat > /etc/nginx/conf.d/default.conf << 'NGINX_EOF'
server {
    listen 3000;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Main dashboard
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Admin panel
    location /admin/ {
        try_files $uri $uri/ /admin/index.html;
    }

    # Battle UI
    location /battle/ {
        try_files $uri $uri/ /battle/index.html;
    }

    # API proxy to gateway
    location /api/ {
        proxy_pass http://core:4000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Health endpoint
    location /health {
        return 200 '{"status":"ok","service":"frontend"}';
        add_header Content-Type application/json;
    }
}
NGINX_EOF

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost:3000/health || exit 1

EXPOSE 3000
