# A-TownChain OS — Gateway Dockerfile (K5 Konsolidierung)
# Service: Nginx Reverse Proxy → Core Backend
# Agent: Aurora #2 (6a275618)

FROM nginx:1.25-alpine

LABEL maintainer="ShivaCore <dev@atownchain.io>"
LABEL org.opencontainers.image.source="https://github.com/A-TownChain-Okosystems/a-townchain-os"
LABEL org.opencontainers.image.description="A-TownChain OS — Gateway (Nginx Reverse Proxy)"
LABEL org.opencontainers.image.version="1.0.0"

# Nginx reverse proxy configuration
RUN cat > /etc/nginx/conf.d/default.conf << 'NGINX_EOF'
upstream core_backend {
    server core:4000;
}

upstream blockchain_backend {
    server blockchain:5000;
}

server {
    listen 80;
    server_name localhost;

    # API Gateway → Core
    location /api/ {
        proxy_pass http://core_backend/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Blockchain RPC
    location /rpc/ {
        proxy_pass http://blockchain_backend/rpc/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Health endpoint
    location /health {
        return 200 '{"status":"ok","service":"gateway"}';
        add_header Content-Type application/json;
    }

    # Frontend (if served from gateway)
    location / {
        proxy_pass http://frontend:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
NGINX_EOF

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost:80/health || exit 1

EXPOSE 80 443
