// ATC-17 — Voting-Power Snapshot (Flash-Loan Schutz)
// Sprint 2.6 | Issue #78 | AD-003 RESOLVED
// Snapshot-basiertes Voting: Voting-Power wird zu einem bestimmten
// Block-Height erfasst, nicht realtime. Verhindert Flash-Loan Manipulation.
// ════════════════════════════════════════════════════════════════

const MAX_SNAPSHOTS: u32 = 1000
const SNAPSHOT_GAS: u64 = 20000
const MIN_CONFIRMATIONS: u8 = 3

struct VotingSnapshot {
    snapshot_id: u64,
    block_height: u64,
    timestamp: u64,
    total_voting_power: u128,
    proposal_id: u64,
    taken: bool
}

struct ProposalSnapshot {
    proposal_id: u64,
    snapshot_block: u64,
    snapshot_id: u64,
    total_power: u128,
    flash_loan_detected: bool
}

// Snapshot-Storage
storage {
    snapshots: Map<u64, VotingSnapshot>,
    proposals: Map<u64, ProposalSnapshot>,
    balances_at_block: Map<u64, Map<Address, u128>>,
    next_snapshot_id: u64,
    flash_loan_guard: Map<Address, u64>
}

contract VotingPowerSnapshot {

    // --- Events ---
    event SnapshotTaken(snapshot_id: u64, proposal_id: u64, block_height: u64, total_power: u128)
    event FlashLoanDetected(proposal_id: u64, attacker: Address, block_height: u64)
    event VoteCast(proposal_id: u64, voter: Address, power: u128, snapshot_id: u64)

    // --- Snapshot erstellen für ein Proposal ---
    fn take_snapshot(proposal_id: u64) -> u64 {
        require(msg.sender != Address::ZERO, "Unauthorized");
        require(!storage.proposals.contains(proposal_id), "Snapshot already exists");

        let block_height = block.number;
        let snapshot_id = storage.next_snapshot_id;
        storage.next_snapshot_id = snapshot_id + 1;

        // Alle Balances zum aktuellen Block einfrieren
        let mut total_power: u128 = 0;
        // (In production: iterate over token holders — hier vereinfacht)
        // total_power = token.total_supply_at(block_height);

        let snapshot = VotingSnapshot {
            snapshot_id: snapshot_id,
            block_height: block_height,
            timestamp: block.timestamp,
            total_voting_power: total_power,
            proposal_id: proposal_id,
            taken: true
        };

        storage.snapshots.insert(snapshot_id, snapshot);

        let prop_snapshot = ProposalSnapshot {
            proposal_id: proposal_id,
            snapshot_block: block_height,
            snapshot_id: snapshot_id,
            total_power: total_power,
            flash_loan_detected: false
        };

        storage.proposals.insert(proposal_id, prop_snapshot);

        emit SnapshotTaken(snapshot_id, proposal_id, block_height, total_power);
        return snapshot_id;
    }

    // --- Voting-Power abfragen (immer vom Snapshot, nie realtime) ---
    fn get_voting_power(voter: Address, proposal_id: u64) -> u128 {
        require(storage.proposals.contains(proposal_id), "No snapshot for proposal");

        let prop = storage.proposals.get(proposal_id);
        let snapshot = storage.snapshots.get(prop.snapshot_id);

        // Flash-Loan-Check: Hat der Voter im gleichen Block大幅 ein-/ausgezahlt?
        if storage.flash_loan_guard.contains(voter) {
            let last_action_block = storage.flash_loan_guard.get(voter);
            if last_action_block == snapshot.block_height {
                emit FlashLoanDetected(proposal_id, voter, snapshot.block_height);
                return 0;  // Voting-Power = 0 bei Flash-Loan-Verdacht
            }
        }

        // Balance vom Snapshot-Block, nicht aktuelle Balance
        if storage.balances_at_block.contains(snapshot.snapshot_id) {
            let balances = storage.balances_at_block.get(snapshot.snapshot_id);
            if balances.contains(voter) {
                return balances.get(voter);
            }
        }

        return 0;
    }

    // --- Abstimmung mit Snapshot-Power ---
    fn vote(proposal_id: u64, support: bool) -> bool {
        require(storage.proposals.contains(proposal_id), "No snapshot for proposal");

        let power = get_voting_power(msg.sender, proposal_id);
        require(power > 0, "No voting power at snapshot");

        let prop = storage.proposals.get(proposal_id);
        emit VoteCast(proposal_id, msg.sender, power, prop.snapshot_id);
        return true;
    }

    // --- Flash-Loan-Erkennung: Markiere Addressen die im gleichen Block large transfers machen ---
    fn flag_flash_loan(addr: Address, block_height: u64) -> bool {
        storage.flash_loan_guard.insert(addr, block_height);
        return true;
    }

    // --- Validator: Prüfe ob Snapshot gültig ist ---
    fn validate_snapshot(snapshot_id: u64) -> bool {
        if !storage.snapshots.contains(snapshot_id) {
            return false;
        }
        let snapshot = storage.snapshots.get(snapshot_id);
        if !snapshot.taken {
            return false;
        }
        // Mindestens MIN_CONFIRMATIONS Blocks müssen vergangen sein
        if block.number < snapshot.block_height + MIN_CONFIRMATIONS as u64 {
            return false;
        }
        return true;
    }

    // --- Admin: Snapshot manuell auslösen ---
    fn emergency_snapshot(proposal_id: u64) -> u64 {
        require(msg.sender == admin, "Admin only");
        return take_snapshot(proposal_id);
    }
}
