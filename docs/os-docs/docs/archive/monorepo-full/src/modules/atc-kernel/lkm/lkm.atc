// K-Sprint 48 — Loadable Kernel Modules (ATCLang Interface)
// Dynamic module loading/unloading with dependency resolution.
// ─────────────────────────────────────────────────────────────

module Kernel::Lkm {

    enum ModuleState {
        Registered,
        Loading,
        Active,
        Unloading,
        Failed,
        Unloaded,
    }

    enum ModulePriority {
        Core = 0,
        Driver = 1,
        FileSystem = 2,
        Network = 3,
        Security = 4,
        Utility = 5,
        Custom = 9,
    }

    enum ModuleLicense {
        Gpl,
        Mit,
        Bsd,
        Apache,
        Proprietary,
    }

    struct ModuleParam {
        name: String,
        description: String,
        default_value: String,
        current_value: String,
        read_only: bool,
        param_type: String,
    }

    struct ExportedSymbol {
        name: String,
        module_name: String,
        ref_count: u64,
        symbol_type: String,
    }

    struct ModuleDescriptor {
        id: u64,
        name: String,
        version: String,
        description: String,
        author: String,
        license: ModuleLicense,
        priority: ModulePriority,
        state: ModuleState,
        dependencies: List<String>,
        optional_deps: List<String>,
        conflicts: List<String>,
        provides: List<String>,
        params: List<ModuleParam>,
        exports: List<ExportedSymbol>,
        ref_count: u64,
        auto_load: bool,
    }

    contract ModuleRegistry {
        state modules: Map<String, ModuleDescriptor>
        state symbol_table: Map<String, ExportedSymbol>
        state next_id: u64
        state kernel_tainted: bool

        event ModuleRegistered(name: String, id: u64)
        event ModuleLoaded(name: String, id: u64)
        event ModuleUnloaded(name: String, id: u64)
        event ModuleFailed(name: String, reason: String)
        event SymbolResolved(symbol: String, by_module: String)
        event ParamChanged(module: String, param: String, value: String)

        // Registration
        fn register(module: ModuleDescriptor) -> u64
        fn unregister(name: String) -> bool

        // Loading
        fn load(name: String) -> u64
        fn unload(name: String) -> bool
        fn reload(name: String) -> bool
        fn auto_load_all() -> u64

        // Reference management
        fn acquire_ref(name: String) -> u64
        fn release_ref(name: String) -> u64

        // Symbol management
        fn lookup_symbol(name: String) -> Option<ExportedSymbol>
        fn resolve_symbol(name: String) -> bool

        // Parameters
        fn set_param(module: String, param: String, value: String) -> bool
        fn get_param(module: String, param: String) -> String

        // Queries
        fn get_module(name: String) -> Option<ModuleDescriptor>
        fn list_active() -> List<ModuleDescriptor>
        fn list_by_priority(priority: ModulePriority) -> List<ModuleDescriptor>
        fn list_by_state(state: ModuleState) -> List<ModuleDescriptor>
        fn module_count() -> u64
        fn active_count() -> u64
        fn is_tainted() -> bool
    }
}
